generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperimentStatus {
  draft
  active
  paused
  completed
  cancelled
}

enum QueryType {
  core
  close_variation
  semantic
  local
  long_tail
}

enum TreatmentGroup {
  search
  direct
  none
}

enum ScheduledSessionStatus {
  scheduled
  running
  completed
  cancelled
}

enum SessionStatus {
  scheduled
  running
  completed
  target_not_found
  search_abandoned
  target_found_no_click
  blocked
  google_error
  browser_error
  proxy_error
  target_error
  cancelled
}

enum SessionEventType {
  browser_started
  google_loaded
  search_entered
  search_submitted
  serp_loaded
  serp_scrolled
  serp_inspected
  query_reformulated
  target_found
  target_skipped
  target_clicked
  landing_loaded
  scroll
  internal_click
  back_to_serp
  search_abandoned
  session_completed
  blocked
  error
  local_pack_found
  gmb_opened
  gmb_action_website
  gmb_action_directions
  gmb_action_call
  target_not_found
}

enum ProfileProvider {
  gologin
  multilogin
  mock
  camoufox
}

enum DeviceClass {
  desktop
  mobile
}

enum TreatmentIntensity {
  low
  normal
  strong
}

enum CtrSource {
  default_curve
  gsc_site_curve
}

enum CampaignKind {
  url
  gmb
}

/** Where campaign sessions may draw identities from. */
enum IdentityGeoScope {
  city
  country
}

enum WarmupStatus {
  warming
  eligible
}

enum WarmupSessionStatus {
  scheduled
  running
  completed
  failed
  cancelled
}

enum WarmupSessionKind {
  browse
  benign
  graduation
}

enum RankSnapshotKind {
  baseline
  daily
  manual
  followup
}

enum GeoGridScanKind {
  baseline
  weekly
  manual
  followup
}

enum GeoGridScanStatus {
  pending
  running
  complete
  partial
  error
}

enum RankSnapshotStatus {
  pending
  running
  captured
  not_found
  blocked
  error
}

model Experiment {
  id                   String           @id @default(cuid())
  name                 String
  slug                 String           @unique
  targetUrl            String           @map("target_url")
  targetDomain         String           @map("target_domain")
  campaignKind         CampaignKind     @default(url) @map("campaign_kind")
  status               ExperimentStatus @default(draft)
  startDate            DateTime?        @map("start_date")
  endDate              DateTime?        @map("end_date")
  baselineStartDate    DateTime?        @map("baseline_start_date")
  baselineEndDate      DateTime?        @map("baseline_end_date")
  monthlySessionTarget Int              @default(300) @map("monthly_session_target")
  baselineDays         Int              @default(28) @map("baseline_days")
  treatmentDays        Int              @default(28) @map("treatment_days")
  postTreatmentDays    Int              @default(21) @map("post_treatment_days")
  maxSerpPages         Int              @default(4) @map("max_serp_pages")
  scheduleTimezone     String           @default("Australia/Adelaide") @map("schedule_timezone")
  scheduleStart        String           @default("06:30") @map("schedule_start")
  scheduleEnd          String           @default("23:00") @map("schedule_end")
  maxSessionsPerIdentityPerDay Int      @default(1) @map("max_sessions_per_identity_per_day")
  repeatIdentityMinGapDays   Int      @default(2) @map("repeat_identity_min_gap_days")
  minMinutesBetweenGlobalSessions Int @default(5) @map("min_minutes_between_global_sessions")
  focusRegion          String?          @map("focus_region")
  focusCity            String?          @map("focus_city")
  /** city = lock to focusCity; country = any identity in experiment.country. */
  identityGeoScope     IdentityGeoScope @default(city) @map("identity_geo_scope")
  gmbBusinessName      String?          @map("gmb_business_name")
  gmbPlaceId           String?          @map("gmb_place_id")
  gmbMapsUrl           String?          @map("gmb_maps_url")
  gmbActionsJson       String?          @map("gmb_actions_json")
  country              String           @default("AU")
  campaignDurationDays Int              @default(14) @map("campaign_duration_days")
  treatmentIntensity   TreatmentIntensity @default(normal) @map("treatment_intensity")
  adaptivePacing       Boolean          @default(true) @map("adaptive_pacing")
  recalculateEveryDays Int              @default(3) @map("recalculate_every_days")
  maxShareOfSearchDemand Float          @default(0.02) @map("max_share_of_search_demand")
  maxShareOfGscImpressions Float        @default(0.05) @map("max_share_of_gsc_impressions")
  desktopPercent       Int              @default(65) @map("desktop_percent")
  ctrSource            CtrSource        @default(default_curve) @map("ctr_source")
  gscConnectionId      String?          @map("gsc_connection_id")
  gscSiteUrl           String?          @map("gsc_site_url")
  lastPacingRecalcAt   DateTime?        @map("last_pacing_recalc_at")
  /** User overrides from the session plan; null = use the calculated value. */
  plannedSessionCap    Int?             @map("planned_session_cap")
  targetIdentityCount  Int?             @map("target_identity_count")
  organicMaxSessionsPerIdentity Int     @default(2) @map("organic_max_sessions_per_identity")
  requireWarmupIdentities Boolean       @default(true) @map("require_warmup_identities")
  /** Browser GPS centre for local campaigns; each identity gets a stable point within geoRadiusKm. */
  geoLatitude          Float?           @map("geo_latitude")
  geoLongitude         Float?           @map("geo_longitude")
  geoRadiusKm          Float?           @map("geo_radius_km")
  /** Where rank checks search from; null = the campaign city's centre. */
  rankCheckLatitude    Float?           @map("rank_check_latitude")
  rankCheckLongitude   Float?           @map("rank_check_longitude")
  /** Coverage grid: points per side (null = 5) and spacing between points (null = 2 km). */
  gridSize             Int?             @map("grid_size")
  gridSpacingKm        Float?           @map("grid_spacing_km")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  queries          ExperimentQuery[]
  scheduledSessions ScheduledSession[]
  sessions         Session[]
  rankingSnapshots RankingSnapshot[]
  rankSnapshots    RankSnapshot[]
  sessionSnapshots SessionSnapshot[]
  geoGridScans     GeoGridScan[]
  notes            ExperimentNote[]
  gscConnection    GscConnection?   @relation(fields: [gscConnectionId], references: [id], onDelete: SetNull)
  selectedIdentities ExperimentIdentity[]

  @@map("experiments")
}

model GscConnection {
  id           String   @id @default(cuid())
  label        String
  googleEmail  String?  @map("google_email")
  refreshToken String   @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  experiments Experiment[]

  @@map("gsc_connections")
}

model ExperimentQuery {
  id           String    @id @default(cuid())
  experimentId String    @map("experiment_id")
  query        String
  queryType    QueryType @map("query_type")
  weight       Float
  active       Boolean   @default(true)
  monthlySearchVolume Int?    @map("monthly_search_volume")
  startingPosition    Float?  @map("starting_position")
  gscImpressions28d   Int?    @map("gsc_impressions_28d")
  gscClicks28d        Int?    @map("gsc_clicks_28d")
  allocatedSessions   Int?    @map("allocated_sessions")
  createdAt    DateTime  @default(now()) @map("created_at")

  experiment        Experiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  scheduledSessions ScheduledSession[]

  @@unique([experimentId, query])
  @@map("experiment_queries")
}

model Identity {
  id               String          @id @default(cuid())
  externalId       String          @unique @map("external_id")
  externalProfileId String?        @map("external_profile_id")
  profileProvider  ProfileProvider @default(mock) @map("profile_provider")
  deviceClass      DeviceClass     @map("device_class")
  osFamily         String          @map("os_family")
  browserFamily    String          @default("chromium") @map("browser_family")
  locale           String          @default("en-AU")
  timezone         String
  country          String          @default("AU")
  region           String
  city             String
  active           Boolean         @default(true)
  totalSessions    Int             @default(0) @map("total_sessions")
  googleSessions   Int             @default(0) @map("google_sessions")
  targetClicks     Int             @default(0) @map("target_clicks")
  blockedSessions  Int             @default(0) @map("blocked_sessions")
  lastQuery        String?         @map("last_query")
  lastExperimentId String?         @map("last_experiment_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  lastUsedAt       DateTime?       @map("last_used_at")
  personaId        String?         @map("persona_id")
  personaAssignedAt DateTime?      @map("persona_assigned_at")
  warmupStatus     WarmupStatus    @default(warming) @map("warmup_status")
  warmupSessionsCompleted Int      @default(0) @map("warmup_sessions_completed")
  warmupSiteClicks   Int             @default(0) @map("warmup_site_clicks")
  warmupGraduationPassed Boolean     @default(false) @map("warmup_graduation_passed")
  warmupEligibleAt DateTime?       @map("warmup_eligible_at")
  /** Google blocks since the last clean Google session; park at 2. */
  consecutiveBlocks Int            @default(0) @map("consecutive_blocks")

  scheduledSessions ScheduledSession[]
  sessions          Session[]
  warmupSessions    WarmupSession[]
  campaignSelections ExperimentIdentity[]

  @@map("identities")
}

model WarmupSession {
  id           String              @id @default(cuid())
  identityId   String              @map("identity_id")
  queryText    String              @map("query_text")
  kind         WarmupSessionKind   @default(benign)
  scheduledAt  DateTime            @map("scheduled_at")
  status       WarmupSessionStatus @default(scheduled)
  attemptCount Int                 @default(0) @map("attempt_count")
  sessionId    String?             @map("session_id")
  createdAt    DateTime            @default(now()) @map("created_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("warmup_sessions")
}

model ExperimentIdentity {
  experimentId String @map("experiment_id")
  identityId   String @map("identity_id")
  selected     Boolean @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  identity   Identity   @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([experimentId, identityId])
  @@map("experiment_identities")
}

model ScheduledSession {
  id           String                 @id @default(cuid())
  experimentId String                 @map("experiment_id")
  identityId   String                 @map("identity_id")
  queryId      String                 @map("query_id")
  group        TreatmentGroup
  scheduledAt  DateTime               @map("scheduled_at")
  status       ScheduledSessionStatus @default(scheduled)
  attemptCount Int                    @default(0) @map("attempt_count")
  createdAt    DateTime               @default(now()) @map("created_at")

  experiment Experiment      @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  identity   Identity        @relation(fields: [identityId], references: [id])
  query      ExperimentQuery @relation(fields: [queryId], references: [id])
  sessions   Session[]

  @@index([experimentId, scheduledAt])
  @@index([identityId, scheduledAt])
  @@map("scheduled_sessions")
}

model Session {
  id                 String        @id @default(cuid())
  scheduledSessionId String?       @map("scheduled_session_id")
  experimentId       String        @map("experiment_id")
  identityId         String        @map("identity_id")
  queryText          String        @map("query_text")
  group              TreatmentGroup
  startedAt          DateTime?     @map("started_at")
  endedAt            DateTime?     @map("ended_at")
  status             SessionStatus @default(running)

  proxyProvider String? @map("proxy_provider")
  proxyCountry  String? @map("proxy_country")
  proxyRegion   String? @map("proxy_region")
  proxyCity     String? @map("proxy_city")
  proxyIpHash   String? @map("proxy_ip_hash")

  googleLoaded     Boolean? @map("google_loaded")
  searchSubmitted  Boolean? @map("search_submitted")
  targetFound      Boolean? @map("target_found")
  serpPage         Int?     @map("serp_page")
  observedPosition Int?     @map("observed_position")
  resultTitle      String?  @map("result_title")
  resultUrl        String?  @map("result_url")

  targetClicked Boolean? @map("target_clicked")
  landingUrl    String?  @map("landing_url")
  finalUrl      String?  @map("final_url")

  pageviews       Int   @default(0)
  internalClicks  Int   @default(0) @map("internal_clicks")
  scrollDepth     Float @default(0) @map("scroll_depth")
  durationSeconds Int   @default(0) @map("duration_seconds")
  bytesTransferred BigInt @default(0) @map("bytes_transferred")

  engagementTemplate String? @map("engagement_template")
  personaId          String? @map("persona_id")
  sessionTraitsJson  String? @map("session_traits_json")
  searchAttempts     Int     @default(1) @map("search_attempts")
  queriesUsedJson    String? @map("queries_used_json")
  targetSkipped      Boolean @default(false) @map("target_skipped")
  backToSerp         Boolean @default(false) @map("back_to_serp")
  blockReason        String? @map("block_reason")
  errorCode          String? @map("error_code")
  errorMessage       String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  scheduledSession ScheduledSession? @relation(fields: [scheduledSessionId], references: [id])
  experiment       Experiment        @relation(fields: [experimentId], references: [id])
  identity         Identity          @relation(fields: [identityId], references: [id])
  events           SessionEvent[]

  @@index([experimentId, createdAt])
  @@index([identityId, createdAt])
  @@map("sessions")
}

model SessionEvent {
  id           String           @id @default(cuid())
  sessionId    String           @map("session_id")
  timestamp    DateTime         @default(now())
  eventType    SessionEventType @map("event_type")
  metadataJson String?          @map("metadata_json")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@map("session_events")
}

model RankingSnapshot {
  id           String   @id @default(cuid())
  experimentId String   @map("experiment_id")
  date         DateTime @db.Date
  query        String
  page         String
  country      String   @default("AU")
  device       String?
  clicks       Int      @default(0)
  impressions  Int      @default(0)
  ctr          Float    @default(0)
  position     Float
  source       String   @default("gsc")
  createdAt    DateTime @default(now()) @map("created_at")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, date, query, page, country, device, source])
  @@index([experimentId, query, date])
  @@map("ranking_snapshots")
}

model ExperimentNote {
  id           String   @id @default(cuid())
  experimentId String   @map("experiment_id")
  date         DateTime @db.Date
  event        String
  severity     String   @default("info")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@map("experiment_notes")
}

/** Pinned Camoufox device identity for one profile (reused every launch). */
model BrowserFingerprint {
  profileId       String   @id @map("profile_id")
  os              String
  fingerprintJson String   @map("fingerprint_json")
  webglVendor     String   @map("webgl_vendor")
  webglRenderer   String   @map("webgl_renderer")
  seedsJson       String   @map("seeds_json")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("browser_fingerprints")
}

/** /24 egress prefixes that recently hit a Google block — skipped before Google. */
model BlockedIpPrefix {
  prefix        String   @id
  blockCount    Int      @default(1) @map("block_count")
  lastBlockedAt DateTime @default(now()) @map("last_blocked_at")

  @@map("blocked_ip_prefixes")
}

/** Proxy /24s that egressed outside the requested area or rotated mid-lease; skipped on allocation. */
model BadGeoIpPrefix {
  prefix       String
  /** "*" when the range left the country (bad for every city), else the city slug it missed. */
  scope        String
  reason       String
  failCount    Int      @default(1) @map("fail_count")
  lastGeo      String?  @map("last_geo")
  lastFailedAt DateTime @default(now()) @map("last_failed_at")

  @@id([prefix, scope])
  @@map("bad_geo_ip_prefixes")
}

/** Screenshot of the live SERP/local pack for one query — baseline, end-of-day or on demand. */
model RankSnapshot {
  id           String             @id @default(cuid())
  experimentId String             @map("experiment_id")
  query        String
  kind         RankSnapshotKind
  /** National URL campaigns: the panel city this check searched from; "" for local campaigns. */
  panelCity    String             @default("") @map("panel_city")
  /** YYYY-MM-DD in the campaign's schedule timezone. */
  localDate    String             @map("local_date")
  scheduledAt  DateTime           @default(now()) @map("scheduled_at")
  status       RankSnapshotStatus @default(pending)
  attemptCount Int                @default(0) @map("attempt_count")
  position     Int?
  serpPage     Int?               @map("serp_page")
  source       String?
  resultTitle  String?            @map("result_title")
  pageUrl      String?            @map("page_url")
  egressCity   String?            @map("egress_city")
  identityExternalId String?      @map("identity_external_id")
  imageJpeg    Bytes?             @map("image_jpeg")
  /** Results page before any fallback to the Places list; null when the rank came from it. */
  serpImageJpeg Bytes?            @map("serp_image_jpeg")
  errorMessage String?            @map("error_message")
  capturedAt   DateTime?          @map("captured_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, query, localDate, kind, panelCity])
  @@index([status, scheduledAt])
  @@map("rank_snapshots")
}

/** One coverage-grid run: the same query searched from every point of a grid around the rank check location. */
model GeoGridScan {
  id                 String            @id @default(cuid())
  experimentId       String            @map("experiment_id")
  query              String
  kind               GeoGridScanKind
  /** YYYY-MM-DD in the campaign's schedule timezone. */
  localDate          String            @map("local_date")
  scheduledAt        DateTime          @default(now()) @map("scheduled_at")
  status             GeoGridScanStatus @default(pending)
  attemptCount       Int               @default(0) @map("attempt_count")
  centreLatitude     Float             @map("centre_latitude")
  centreLongitude    Float             @map("centre_longitude")
  gridSize           Int               @map("grid_size")
  spacingKm          Float             @map("spacing_km")
  identityExternalId String?           @map("identity_external_id")
  inPackCount        Int?              @map("in_pack_count")
  foundCount         Int?              @map("found_count")
  avgRank            Float?            @map("avg_rank")
  /** Points where the target was in the phone results' 3-pack; null until the mobile pass ran. */
  mobileInPackCount  Int?              @map("mobile_in_pack_count")
  mobileAttemptCount Int               @default(0) @map("mobile_attempt_count")
  mobileIdentityExternalId String?     @map("mobile_identity_external_id")
  centreImageJpeg    Bytes?            @map("centre_image_jpeg")
  errorMessage       String?           @map("error_message")
  startedAt          DateTime?         @map("started_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  experiment Experiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  points     GeoGridPoint[]

  @@unique([experimentId, query, localDate, kind])
  @@index([status, scheduledAt])
  @@map("geo_grid_scans")
}

model GeoGridPoint {
  id             String             @id @default(cuid())
  scanId         String             @map("scan_id")
  row            Int
  col            Int
  latitude       Float
  longitude      Float
  status         RankSnapshotStatus @default(pending)
  position       Int?
  source         String?
  resultTitle    String?            @map("result_title")
  /** 3-pack titles seen at this point, so competitor movement is visible. */
  topResultsJson String?            @map("top_results_json")
  errorMessage   String?            @map("error_message")
  capturedAt     DateTime?          @map("captured_at")
  /** 1-3 when the target was in the phone 3-pack at this point. */
  mobilePackPosition   Int?         @map("mobile_pack_position")
  mobileTopResultsJson String?      @map("mobile_top_results_json")
  mobileCheckedAt      DateTime?    @map("mobile_checked_at")

  scan GeoGridScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, row, col])
  @@map("geo_grid_points")
}

/** What the session saw when it found the target, captured just before clicking. */
model SessionSnapshot {
  sessionId          String   @id @map("session_id")
  experimentId       String   @map("experiment_id")
  query              String
  position           Int?
  serpPage           Int?     @map("serp_page")
  source             String?
  resultTitle        String?  @map("result_title")
  pageUrl            String?  @map("page_url")
  egressCity         String?  @map("egress_city")
  identityExternalId String?  @map("identity_external_id")
  imageJpeg          Bytes    @map("image_jpeg")
  createdAt          DateTime @default(now()) @map("created_at")

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, createdAt])
  @@map("session_snapshots")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
