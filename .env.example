DATABASE_URL=postgresql://ctr:ctr@localhost:5432/ctr

BROWSER_PROFILE_PROVIDER=gologin
PROXY_PROVIDER=premiumports
DRY_RUN=false
EXPERIMENT_RUNNER_ENABLED=true

GOLOGIN_API_TOKEN=
MULTILOGIN_API_TOKEN=

# Warmup: 4-day age gate; required actions spread across those days
WARMUP_MIN_DAYS=4
WARMUP_BENIGN_SITE_CLICKS=2
WARMUP_SPREAD_DAYS=7
WARMUP_WINDOW_HOURS=168
WARMUP_SESSION_GAP_MINUTES=120
WARMUP_FIRST_DELAY_HOURS=36

# Premium Ports (sticky residential)
PREMIUMPORTS_PROXY_HOST=144.217.7.189
PREMIUMPORTS_PROXY_PORT=8888
PREMIUMPORTS_PROXY_USERNAME=
PREMIUMPORTS_PROXY_PASSWORD=

# Desktop sessions (Decodo Residential) — rollback via PROXY_PROVIDER=decodo
DECODO_RESIDENTIAL_PROXY_HOST=gate.decodo.com
DECODO_RESIDENTIAL_PROXY_PORT=7000
DECODO_RESIDENTIAL_PROXY_USERNAME=
DECODO_RESIDENTIAL_PROXY_PASSWORD=

# Mobile sessions (Decodo Mobile)
DECODO_MOBILE_PROXY_HOST=gate.decodo.com
DECODO_MOBILE_PROXY_PORT=7000
DECODO_MOBILE_PROXY_USERNAME=
DECODO_MOBILE_PROXY_PASSWORD=

REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379

GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=sc-domain:example.com.au
GSC_OAUTH_REDIRECT_URI=http://localhost:3001/gsc/oauth/callback
DASHBOARD_URL=http://localhost:3000
GA4_PROPERTY_ID=

ADMIN_API_KEY=dev-admin-key
DASHBOARD_PASSWORD=changeme
API_PORT=3001
