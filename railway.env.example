# Paste into Railway → Service → Variables → Raw Editor
# Replace placeholders with your real values from Neon + Upstash

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
REDIS_URL=rediss://default:TOKEN@YOUR.upstash.io:6379
ADMIN_API_KEY=change-me-to-a-long-random-secret
DASHBOARD_PASSWORD=change-me-to-a-simple-password
DRY_RUN=false
BROWSER_PROFILE_PROVIDER=gologin
PROXY_PROVIDER=decodo
EXPERIMENT_RUNNER_ENABLED=true
GOLOGIN_API_TOKEN=
# orbita = Orbita on worker + Decodo (anti-detect + AU). cloud = GoLogin hosts. chromium = stock only.
GOLOGIN_BROWSER_RUNTIME=orbita
# false = headful Orbita via xvfb (fewer Google blocks). true = headless (default).
GOLOGIN_HEADLESS=false
# Warmup pacing (defaults: 0 min age, 2 site clicks, 48h interleaved pool)
WARMUP_MIN_DAYS=0
WARMUP_BENIGN_SITE_CLICKS=2
WARMUP_SPREAD_DAYS=1
WARMUP_SESSION_GAP_MINUTES=30
WARMUP_WINDOW_HOURS=48
WARMUP_BENIGN_RETRY_HOURS=2
WARMUP_GRADUATION_RETRY_HOURS=3
DECODO_RESIDENTIAL_PROXY_HOST=gate.decodo.com
DECODO_RESIDENTIAL_PROXY_PORT=7000
DECODO_RESIDENTIAL_PROXY_USERNAME=
DECODO_RESIDENTIAL_PROXY_PASSWORD=
DECODO_MOBILE_PROXY_HOST=gate.decodo.com
DECODO_MOBILE_PROXY_PORT=7000
DECODO_MOBILE_PROXY_USERNAME=
DECODO_MOBILE_PROXY_PASSWORD=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=sc-domain:example.com.au
GSC_OAUTH_REDIRECT_URI=https://ctr-production-d742.up.railway.app/gsc/oauth/callback
DASHBOARD_URL=https://ctr-teal.vercel.app
NODE_ENV=production
